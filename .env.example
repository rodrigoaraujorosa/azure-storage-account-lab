# Copie para .env (cp .env.example .env) e preencha. O .env não vai para o git.

# Assinatura (vazio = a atual do `az account show`)
AZURE_SUBSCRIPTION_ID=
AZURE_LOCATION=brazilsouth
# Regiões alternativas, se a principal não tiver o serviço:
#   Flex Consumption: az functionapp list-flexconsumption-locations -o table
# FUNC_LOCATION=eastus2
# APIM_LOCATION=brazilsouth

# Obrigatórios para criar o APIM
APIM_PUBLISHER_NAME=
APIM_PUBLISHER_EMAIL=

# Comportamento do microserviço
SAS_TTL_MINUTES=15
MAX_UPLOAD_MB=400

# Origem extra liberada no CORS, para testar o frontend localmente
LOCAL_ORIGIN=http://localhost:8080

# Gerado automaticamente na primeira execução (sufixo dos nomes globais)
SUFFIX=
