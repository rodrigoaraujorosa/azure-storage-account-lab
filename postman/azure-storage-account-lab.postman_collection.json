        {
          "name": "Enviar 2 MiB com a SAS de 1 KiB (a SAS não limita tamanho)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('uploadUrl')) {",
                  "  throw new Error('Rode antes o pedido de SAS desta pasta.');",
                  "}"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('bigBody', 'x'.repeat(2 * 1048576));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Resultado esperado: 201. A SAS não sabe o tamanho declarado ao microserviço.",
                  "// Mitigação: evento BlobCreated (Event Grid) conferindo o tamanho e apagando o excedente.",
                  "pm.test('201: o Storage aceita mais do que o declarado', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "x-ms-blob-type",
                "value": "BlockBlob"
              },
              {
                "key": "Content-Type",
                "value": "application/octet-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{bigBody}}"
            },
            "url": {
              "raw": "{{uploadUrl}}",
              "host": [
                "{{uploadUrl}}"
              ]
            },
            "description": "Segunda parte: confirma que o limite do microserviço vale para o pedido, não para o upload."
          }
        }
      ]
    }
  ]
}
